# .env.example — copia a .env y rellena
MODELO_CLAUDE=sonnet

# Reparto: Álex y Santi presentan siempre; cada N episodios una invitada
# sustituye a uno de los dos solo ese episodio. 0 = nunca hay invitada.
# La fecha decide el reparto (el mismo día siempre sale igual).
# INVITADA_SUSTITUYE: alterna | aleatorio (semilla por fecha) | alex | santi
INVITADA_CADA_N_EPISODIOS=3
INVITADA_SUSTITUYE=alterna
INVITADA_NOMBRE=Lucía

# edge-tts (motor de reserva). En es-ES solo hay una voz masculina (Álvaro, la
# de Álex): Santi la comparte con otro rate y un pitch más grave. Para una voz
# claramente distinta pon p.ej. VOZ_SANTI=es-MX-JorgeNeural. La invitada usa
# Ximena (alternativa: es-ES-ElviraNeural).
VOZ_ALEX=es-ES-AlvaroNeural
VOZ_SANTI=es-ES-AlvaroNeural
VOZ_INVITADA=es-ES-XimenaNeural
RATE_ALEX=-4%
RATE_SANTI=+6%
RATE_INVITADA=+0%
PITCH_ALEX=+0Hz
PITCH_SANTI=-12Hz
PITCH_INVITADA=+0Hz
PAUSA_ENTRE_TURNOS_MS=350

# Pronunciación extra para el motor de voz (JSON), además de las por defecto
# de noticia.voz.texto.PRONUNCIACION. No afecta al guion.md ni al feed.
# PRONUNCIACION_EXTRA={"ia": "i a"}

# Selección de motor de voz: auto | edge | kokoro | chatterbox
MOTOR_VOZ=auto
CONCURRENCIA_LOCUCION=6
REINTENTOS_LOCUCION=2
MAX_FRACCION_FALLOS_LOCUCION=0.10

# Kokoro (motor CPU)
KOKORO_DIR=modelos/kokoro
KOKORO_VOZ_ALEX=em_alex
KOKORO_VOZ_SANTI=em_santa
KOKORO_VOZ_INVITADA=ef_dora
KOKORO_VELOCIDAD_ALEX=0.96
KOKORO_VELOCIDAD_SANTI=1.02
KOKORO_VELOCIDAD_INVITADA=1.05
KOKORO_CONCURRENCIA=2

# Chatterbox Multilingual es-ES (motor GPU)
CHATTERBOX_REF_ALEX=voces/alex_ref.wav
CHATTERBOX_REF_SANTI=voces/santi_ref.wav
CHATTERBOX_REF_INVITADA=voces/invitada_ref.wav
CHATTERBOX_EXAGERACION_ALEX=0.5
CHATTERBOX_EXAGERACION_SANTI=0.55
CHATTERBOX_EXAGERACION_INVITADA=0.6
CHATTERBOX_CFG=0.4
CHATTERBOX_TEMPERATURA=0.8

# Mastering
OBJETIVO_LUFS=-16.0
TRUE_PEAK_DBTP=-1.5
BITRATE_MP3=192k

# Guion
NOTICIAS_POR_BLOQUE=8
REINTENTOS_GUION=1
ESPERA_REINTENTO_GUION_S=30.0

# Publicación
PUBLICACION_URL_BASE=http://localhost:8000
CARPETA_PUBLICACION=output/publicacion
PODCAST_TITULO=NoticIA
PODCAST_DESCRIPCION=La actualidad del día convertida en una tertulia entre amigos: Álex, Santi y, de vez en cuando, una invitada. Guion y voces generados con IA.
PODCAST_AUTOR=NoticIA
PODCAST_EMAIL=
PODCAST_IDIOMA=es-ES
PODCAST_EXPLICITO=false
MAX_ITEMS_FEED=300
