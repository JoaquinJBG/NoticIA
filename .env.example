# .env.example — copia a .env y rellena
MODELO_CLAUDE=sonnet

# edge-tts
VOZ_ALEX=es-ES-AlvaroNeural
VOZ_MARIA=es-ES-ElviraNeural
RATE_ALEX=-4%
RATE_MARIA=+6%
PAUSA_ENTRE_TURNOS_MS=350

# Pronunciación extra para el motor de voz (JSON), además de las por defecto
# de noticia.voz.texto.PRONUNCIACION. No afecta al guion.md ni al feed.
# PRONUNCIACION_EXTRA={"ia": "i a"}

# Selección de motor de voz: auto | edge | kokoro | chatterbox
MOTOR_VOZ=auto
CONCURRENCIA_LOCUCION=6
REINTENTOS_LOCUCION=2
MAX_FRACCION_FALLOS_LOCUCION=0.10

# Kokoro (motor CPU)
KOKORO_DIR=modelos/kokoro
KOKORO_VOZ_ALEX=em_alex
KOKORO_VOZ_MARIA=ef_dora
KOKORO_VELOCIDAD_ALEX=0.96
KOKORO_VELOCIDAD_MARIA=1.05
KOKORO_CONCURRENCIA=2

# Chatterbox Multilingual es-ES (motor GPU)
CHATTERBOX_REF_ALEX=voces/alex_ref.wav
CHATTERBOX_REF_MARIA=voces/maria_ref.wav
CHATTERBOX_EXAGERACION_ALEX=0.5
CHATTERBOX_EXAGERACION_MARIA=0.65
CHATTERBOX_CFG=0.4
CHATTERBOX_TEMPERATURA=0.8

# Mastering
OBJETIVO_LUFS=-16.0
TRUE_PEAK_DBTP=-1.5
BITRATE_MP3=192k

# Guion
NOTICIAS_POR_BLOQUE=8
REINTENTOS_GUION=1
ESPERA_REINTENTO_GUION_S=30.0

# Publicación
PUBLICACION_URL_BASE=http://localhost:8000
CARPETA_PUBLICACION=output/publicacion
PODCAST_TITULO=NoticIA
PODCAST_DESCRIPCION=La actualidad del día convertida en una tertulia entre Álex y María. Guion y voces generados con IA.
PODCAST_AUTOR=NoticIA
PODCAST_EMAIL=
PODCAST_IDIOMA=es-ES
PODCAST_EXPLICITO=false
MAX_ITEMS_FEED=300
